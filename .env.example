# PostgreSQL 접속 정보 (둘 중 하나만 설정)
DATABASE_URL=postgres://user:password@localhost:5432/sungjuk

# 또는 개별 값으로:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=sungjuk

PORT=3000

# 관리자 로그인 JWT 서명 키 — 운영 환경에서는 반드시 랜덤한 긴 문자열로 교체하세요.
JWT_SECRET=change-me-to-a-long-random-string
# 관리자 토큰 유효 기간 (jsonwebtoken expiresIn 형식, 예: 12h, 7d)
ADMIN_TOKEN_TTL=12h
